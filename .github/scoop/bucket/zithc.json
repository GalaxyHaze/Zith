  "bin": "zithc.exe",
  "checkver": {
    "github": "GalaxyHaze/Zith-Lang"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": [
          "https://github.com/GalaxyHaze/Zith-Lang/releases/download/v$version/zithc-windows-amd64.exe",
          "https://github.com/GalaxyHaze/Zith-Lang/releases/download/v$version/zithc-stdlib-v$version.zip"
        ]
      },
      "arm64": {
        "url": [
          "https://github.com/GalaxyHaze/Zith-Lang/releases/download/v$version/zithc-windows-arm64.exe",
          "https://github.com/GalaxyHaze/Zith-Lang/releases/download/v$version/zithc-stdlib-v$version.zip"
        ]
      }
    }
  },
  "installer": {
    "script": [
      "if ($architecture -eq '64bit') { Rename-Item \"$dir\\zithc-windows-amd64.exe\" \"zithc.exe\" }",
      "if ($architecture -eq 'arm64') { Rename-Item \"$dir\\zithc-windows-arm64.exe\" \"zithc.exe\" }",
      "$StdlibRoot = Split-Path $dir -Parent",
      "$StdlibDir = Join-Path $StdlibRoot 'share\\zith\\stdlib'",
      "$StdlibSource = Join-Path $dir 'std'",
      "if (-not (Test-Path -LiteralPath $StdlibSource -PathType Container)) { throw 'Scoop did not extract the stdlib archive' }",
      "New-Item -ItemType Directory -Path $StdlibDir -Force | Out-Null",
      "Get-ChildItem $StdlibDir -Force | Remove-Item -Recurse -Force",
      "Copy-Item -LiteralPath $StdlibSource -Destination $StdlibDir -Recurse -Force",
      "Remove-Item \"$dir\\zithc-stdlib-*.zip\" -Force -ErrorAction SilentlyContinue"
    ]
  }
}
