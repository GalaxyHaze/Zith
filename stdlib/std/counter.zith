pub struct Counter {
    pub index: i32 = 0,
    pub limit: i32 = 0,
    pub step: i32 = 1,
    pub inclusive: bool = false,

    fn next(var self): ?i32 {
        if (self->inclusive) {
            if (self->index > self->limit) {
                return null;
            }
        } else {
            if (self->index >= self->limit) {
                return null;
            }
        }
        let value = self->index;
        self->index = self->index + self->step;
        return value;
    }
}
