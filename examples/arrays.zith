// Exercises: array literals, fixed-size `[N]T` types passed by value and
// indexed, and `@sizeOf` on both a builtin type and a struct.
// Note: a `[N]T` does not implicitly coerce to a slice `[]T` today.
// Expected exit code: 5

struct Point {
    x: i32,
    y: i32,
}

fn second(values: [4]i32): i32 {
    return values[1];
}

fn main(): i32 {
    var numbers: [4]i32 = [1, 2, 3, 4];

    if (numbers[0] != 1) {
        return 1;
    }
    numbers[3] = 9;
    if (numbers[3] != 9) {
        return 2;
    }
    if (second(numbers) != 2) {
        return 3;
    }
    if (@sizeOf(i32) != 4) {
        return 4;
    }
    if (@sizeOf(Point) != 8) {
        return 5;
    }
    return 5;
}
