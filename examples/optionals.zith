// Exercises: optional types `?T`, `return null`, the `?` propagation operator in
// a function returning `?T`, `is null` tests, optional pointers `?*T`, and the
// implicit `T -> ?T` coercion.
// Expected exit code: 0

fn halfIfEven(n: i32): ?i32 {
    if ((n - ((n / 2) * 2)) != 0) {
        return null;
    }
    return n / 2;
}

fn quarter(n: i32): ?i32 {
    let half: i32 = halfIfEven(n)?;
    return halfIfEven(half);
}

fn main(): i32 {
    let some: ?i32 = halfIfEven(8);
    if (some is null) {
        return 1;
    }

    let none: ?i32 = halfIfEven(7);
    if (not (none is null)) {
        return 2;
    }

    // `quarter` short-circuits to null through `?` when its input is odd.
    let bad: ?i32 = quarter(6);
    if (not (bad is null)) {
        return 3;
    }
    let good: ?i32 = quarter(8);
    if (good is null) {
        return 4;
    }

    var value: i32 = 5;
    var maybe: ?*i32 = &value;
    if (maybe is null) {
        return 6;
    }
    maybe = null;
    if (not (maybe is null)) {
        return 7;
    }

    return 0;
}
