// Exercises: nested structs, pointers, arrow access, dereference, by-value
// parameters, and arrays of structs.
// Expected exit code: 7

struct Point {
    x: i32,
    y: i32,
}

struct Rect {
    origin: Point,
    size: Point,
}

fn width(r: *Rect): i32 {
    return r->size.x;
}

fn main(): i32 {
    var box: Rect = Rect {
        origin: Point { x: 1, y: 2 },
        size: Point { x: 4, y: 6 },
    };

    let p: *Rect = &box;
    let copy: Rect = *p;
    if (copy.origin.y != 2) {
        return 1;
    }
    if (width(p) != 4) {
        return 2;
    }
    return copy.size.x + raw box.origin.x + 2;
}
