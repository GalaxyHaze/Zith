// simple-feature.zith
// Demonstrates boolean `and`/`or`/`xor`, `not`, optional conditions and the
// explicit `raw x` escape for a binding initialized later in the block.
// Expected exit code: 0

fn main(): i32 {
    var enabled: bool = true;
    var blocked: bool = false;

    if ((enabled and not blocked) or blocked) {
    } else {
        return 1;
    }
    if ((enabled xor blocked) != true) {
        return 2;
    }
    if ((enabled and blocked) or not enabled) {
        return 3;
    }

    var maybe: ?i32 = 7;
    if (optional maybe) {
    } else {
        return 4;
    }
    if (not (maybe?)) {
        return 5;
    }

    var value: i32;
    value = 9;
    if (raw value != 9) {
        return 6;
    }

    return 0;
}
