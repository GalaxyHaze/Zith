// SDL2 through Zith C interop. The C shim keeps SDL struct/macro details in
// C, where SDL headers are unambiguous, while Zith declares the C functions
// it calls with extern fn and runs the frame loop.
//
// Build: zithc build   (with ZithProject.toml [ffi] config below)
// Flags: -I /usr/include/SDL2 -L /usr/lib -l SDL2

extern fn zsdl_init(flags: u32): bool
extern fn zsdl_poll_quit(): bool
extern fn zsdl_render_clear()
extern fn zsdl_render_rect(x: i32, y: i32, w: i32, h: i32)
extern fn zsdl_render_present()
extern fn zsdl_delay(ms: u32)

fn main(): i32 {
    if (zsdl_init(0x20) == false) {
        return 1;
    }

    for (zsdl_poll_quit() == false) {
        zsdl_render_clear();
        zsdl_render_rect(250, 200, 300, 200);
        zsdl_render_present();
        zsdl_delay(16);
    }
    return 0;
}
