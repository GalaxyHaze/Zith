// advance-feature.zith
// Combines tagged unions with `is` narrowing, `when` dispatch, and `dyn`
// interface dispatch.
// Expected exit code: 15

interface Shape {
    fn area(self): i32
}

struct Square {
    side: i32,
    fn area(self): i32 { self.side * self.side }
}

struct Box {
    width: i32,
    height: i32,
    fn area(self): i32 { self.width * self.height }
}

union Payload { i32, bool }

fn categorize(v: Payload): i32 {
    if (v is i32) {
        let n: i32 = v as i32;
        return when (n) {
            (0) ~> 1,
            (1..10) ~> 2,
            (_) ~> 3,
        };
    }
    if (v is bool) {
        let flag: bool = v;
        if (flag) {
            return 4;
        }
    }
    return 5;
}

fn totalArea(shape: dyn Shape): i32 {
    return shape.area();
}

fn main(): i32 {
    let payload: Payload = Payload { 4 };
    let category: i32 = categorize(payload);
    if (category != 2) {
        return 1;
    }

    let square: Square = Square { side: 3 };
    let box: Box = Box { width: 2, height: 3 };
    let areas: i32 = totalArea(square) + totalArea(box);
    if (areas != 15) {
        return 2;
    }

    return areas;
}
