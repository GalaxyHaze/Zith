// Exercises: explicit slice forwarding and auto-collected variadic tails.
// Expected exit code: 24

fn sum(rest: [...]i32): i32 {
    var total: i32 = 0;
    total = total + raw rest[0];
    total = total + raw rest[1];
    total = total + raw rest[2];
    total = total + raw rest[3];
    total
}

fn main(): i32 {
    let values: [4]i32 = [1, 2, 3, 6];
    sum(...values) + sum(1, 2, 3, 6)
}
