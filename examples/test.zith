// Exercises the stdlib I/O contract: positional formatting, the literal `\#`
// escape, user-formatable structs, and line input.
// Expected exit code: 0

from std/io/console
from std/io/format

struct Point {
    [x, y]: u32,

    fn format(self, dest: lend FormatBuffer): IoError {
        dest.appendRaw("(", 1);
        dest.appendU32(self.x);
        dest.appendRaw(", ", 2);
        dest.appendU32(self.y);
        dest.appendRaw(")", 1);
        return IoError.Ok;
    }
}

implement Point as Formatable {
    fn format(self, dest: lend FormatBuffer): IoError {
        dest.appendRaw("Point#", 6);
        self.format(lend dest);
        return IoError.Ok;
    }
}

fn main(): i32 {
    println("point: #  hash: \#", Point { x: 3, y: 4 });
    print("insert input: ");
    let line = input();
    defer line.destroy();
    if (line.good()) {
        println("read: #", line.text());
    }
    return 0;
}
