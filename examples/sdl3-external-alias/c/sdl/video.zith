pub struct Window {}
pub struct Renderer {}
pub struct FRect {
    pub x: f32,
    pub y: f32,
    pub w: f32,
    pub h: f32,
}

implement Window {
pub fn create(title: *char, width: i32, height: i32, flags: u64): ?*Window = extern SDL_CreateWindow;
pub fn createRenderer(self: lend Window, name: *char): ?*Renderer = extern SDL_CreateRenderer;
pub fn destroy(self: lend Window): void = extern SDL_DestroyWindow;
}

implement Renderer {
pub fn fillRect(self: lend Renderer, rect: *FRect): bool = extern SDL_RenderFillRect;
pub fn destroy(self: lend Renderer): void = extern SDL_DestroyRenderer;
pub fn setDrawColor(self: lend Renderer, r: u8, g: u8, b: u8, a: u8): bool = extern SDL_SetRenderDrawColor;
pub fn clear(self: lend Renderer): bool = extern SDL_RenderClear;
pub fn present(self: lend Renderer): bool = extern SDL_RenderPresent;
}
