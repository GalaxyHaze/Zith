from c/sdl/events

fn main(): i32 {
    if (@sizeOf(SdlEvent) != 128u64) {
        return 1;
    }

    var quitEvent: SdlEvent = fromKind(0x100u32);
    if (kind(quitEvent) != EventType.Quit as u32) {
        return 2;
    }
    if (wantsClose(quitEvent) == false) {
        return 3;
    }

    var closeEvent: SdlEvent = fromKind(0x210u32);
    if (kind(closeEvent) != EventType.WindowCloseRequested as u32) {
        return 4;
    }
    if (wantsClose(closeEvent) == false) {
        return 5;
    }

    var ignoredEvent: SdlEvent = fromKind(0u32);
    if (wantsClose(ignoredEvent)) {
        return 6;
    }

    return 0;
}
