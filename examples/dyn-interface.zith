// dyn Interface dispatch: a concrete struct automatically satisfies a
// structural interface when its fields and methods match. Passing a concrete
// value to a `dyn Interface` parameter builds the fat pointer and dispatches
// each call through the per-type method vtable.
//
// Run: ./build/zithc --include stdlib run examples/dyn-interface.zith
// Exit code: 18 (Cat 3 * 2 == 6, Dog 4 * 3 == 12)

interface Speak {
    fn greet(self): i32
}

struct Cat {
    name: i32,
    fn greet(self): i32 { self.name * 2 }
}

struct Dog {
    name: i32,
    fn greet(self): i32 { self.name * 3 }
}

fn shout(a: dyn Speak): i32 {
    return a.greet();
}

fn main(): i32 {
    let cat: Cat = Cat { name: 3 };
    let dog: Dog = Dog { name: 4 };
    return shout(cat) + shout(dog);
}
