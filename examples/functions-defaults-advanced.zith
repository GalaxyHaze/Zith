// Exercises: methods, `var self`, `var` parameters, and default arguments.
// Expected exit code: 17

struct Counter {
    value: i32,
    fn get(self): i32 { return self.value; }
    fn bump(var self): i32 { self.value += 1; return self.value; }
    fn set(var self, v: i32): i32 { self.value = v; return self.value; }
}

fn addOne(var p: Counter): i32 {
    p.value += 1;
    return p.value;
}

fn main(): i32 {
    var a: Counter = Counter { value: 2 };
    let r1: i32 = a.bump();
    var b: Counter = Counter { value: 7 };
    let r2: i32 = b.set(9);
    var c: Counter = Counter { value: 4 };
    let r3: i32 = addOne(c);
    let d: Counter = Counter { value: r1 + r2 + r3 };
    return d.get();
}
