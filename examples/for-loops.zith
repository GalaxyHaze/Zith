// Exercises: 3-clause `for (init, cond, step)`, conditional `for (cond)`,
// iterator `for (x in iterable)`, bare `for { ... break }`, and the compound
// assignments `+=`, `-=`, `*=`.
// Expected exit code: 10

struct End {}

union CounterStep { End, i32 }

struct Counter {
    current: i32,
    limit: i32,
    fn next(self): CounterStep {
        if (self->current >= self->limit) {
            return CounterStep { End {} };
        }
        let value = CounterStep { self->current };
        self->current = self->current + 1;
        return value;
    }
}

fn main(): i32 {
    var sum: i32 = 0;
    for (var i: i32 = 0, i < 5, i += 1) {
        sum += i;
    }
    // sum == 10

    var countdown: i32 = 3;
    for (countdown > 0) {
        countdown -= 1;
    }
    if (countdown != 0) {
        return 1;
    }

    var total: i32 = 0;
    let counter: Counter = Counter { current: 0, limit: 5 };
    for (n in counter) {
        total += n;
    }
    if (total != 10) {
        return 4;
    }

    var doubled: i32 = 1;
    for {
        doubled *= 2;
        if (doubled >= 8) {
            break;
        }
    }
    if (doubled != 8) {
        return 2;
    }

    return sum;
}
