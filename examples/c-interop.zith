// Exercises: C header imports, a variadic C call (`printf`), and heap
// allocation through `malloc`/`free` with an optional-pointer null guard.
// Prints `v=42` and exits with code 0.

import "stdio.h"
import "stdlib.h"

fn main(): i32 {
    printf("v=%d\n", 42);

    var p: ?*i32 = malloc(64) as ?*i32;
    if (p is null) {
        return 1;
    }
    free(p);
    return 0;
}
