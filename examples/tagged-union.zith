// Exercises: tagged unions, `is Type` member tests, local narrowing inside
// an `if`, checked member casts, and the default tagged-union layout.
// Expected exit code: 0

union Value { i32, f64, bool }

fn handle(v: Value): i32 {
    if (v is i32) {
        let n: i32 = v as i32;
        if (n != 42) {
            return 1;
        }
    } else {
        return 2;
    }

    // The narrowed type is restored outside the if; the tagged value can be
    // tested again with a different member.
    if (v is bool) {
        return 3;
    }
    return 0;
}

fn halfOrFlag(v: Value): i32 {
    if (v is i32) {
        let n: i32 = v as i32;
        return n / 2;
    }
    if (v is f64) {
        let d: f64 = v as f64;
        if (d > 0.0) {
            return 4;
        }
    }
    return 5;
}

fn main(): i32 {
    let i: Value = Value { 42 };
    if (handle(i) != 0) {
        return 11;
    }

    let f: Value = Value { 2.5 };
    if (halfOrFlag(f) != 4) {
        return 12;
    }

    let b: Value = Value { true };
    if (not (b is bool)) {
        return 13;
    }

    return 0;
}
