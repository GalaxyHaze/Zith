// End-to-end acceptance program: nullable pointers, `is null`, conditional `for`,
// multi-character comparison operators, and explicit numeric `as` conversions.

struct Node {
    value: i32,
    next: ?*Node,
}

fn sum(start: ?*Node): i32 {
    var total: i32 = 0;
    var cur: ?*Node = start;
    for (not (cur is null)) {
        total = total + cur->value;
        cur = cur->next;
    }
    return total;
}

fn main(): i32 {
    var tail: Node = Node { value: 3, next: null };
    var head: Node = Node { value: 4, next: &tail };

    let total: i32 = sum(&head);
    if (total != 7) {
        return 1;
    }

    // Explicit conversions only: an implicit i32 -> f64 would be rejected.
    let scaled: f64 = total as f64;
    let back: i32 = scaled as i32;
    if (back == total) {
        return back;
    }
    return 2;
}
