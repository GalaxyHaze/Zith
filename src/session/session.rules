# Zith CompilationSession declarative structure.
#
# Stages appear in the intended pipeline order. Each stage can have a hook that
# runs when runTo() crosses that stage. Handlers receive only the
# CompilationSession; outputs from earlier stages are available through
# hasStageResult<Stage>() / stageResult<Stage>() on the session.
[context]
type: toolkit::session::ZithSessionContext

[stages]
Source: void
Lexed: generated_lexer::TokenStream
Parsed: sample::ParseOutput
Scanned: void
Imported: void
Resolved: void
TypeChecked: void
Solved: void
NraResolved: void
HirLowered: void
CodegenReady: void
Cached: void
