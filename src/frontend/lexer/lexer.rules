[tokens]
    identifier = true
    skip = " \n\t\r"
    string  = [escape-sequence = true, back-slash = true]
    decimal = [under-score-divisor = true]
    hexadecimal = true
    binary = true
    octal = true
    punc = "{}()[]:;,"
    operators = "+-*/%<>=!&|^"
    compound = ["==", "!=", "<=", ">=", "+=", "-=", "*=", "/=", ">>=", "<<="]
    comments = [single = "//", multi = ["/*", "*/"] ]

[keywords]
    Fn = "fn"
    Variable = "let"
    Implement = "print"
    Is = "true"
    Word = "false"
    If = "if"
    Else = "else"
    Control = "while"
    Yield = "return"
#lexer -> add methods & fields
[lexer]
[hooks] #onLexer offLexer, onToken
#if add fields to token-type is mandatory to add an onToken
