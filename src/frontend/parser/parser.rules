# ZCT generic parser helper rules for the Zith showcase.
#
# [parser] declares the user-owned input/output/diagnostic/token types used by
# the generated `Parser<Output>` template. The generated loop remains the token
# cursor and context driver. All recursive Zith grammar lives in handwritten
# `src/frontend/parser/actions.cpp`; this file only keeps a stable TopLevel
# dispatch surface and parser state for recovery runs.

[parser]
input: std::string_view
output: sample::ParseOutput
diagnostic: sample::ParserDiagnostic
tokenStream: generated_lexer::TokenStream
end: Token::End

[contexts]
TopLevel

[state TopLevel]
garbageStart: int
garbageEnd: int
garbageActive: bool
isExternPending: bool

[context TopLevel]
Identifier action=hooks::parser::top()
LitVal action=hooks::parser::top()
Operators action=hooks::parser::top()
Punctuation action=hooks::parser::top()
As action=hooks::parser::top()
Using action=hooks::parser::top()
Type action=hooks::parser::top()
Struct action=hooks::parser::top()
Raw action=hooks::parser::top()
Must action=hooks::parser::top()
Mutable action=hooks::parser::top()
Trait action=hooks::parser::top()
Interface action=hooks::parser::top()
Typedef action=hooks::parser::top()
Implement action=hooks::parser::top()
Fn action=hooks::parser::top()
Module action=hooks::parser::top()
Extern action=hooks::parser::top()
Macro action=hooks::parser::top()
Context action=hooks::parser::top()
Variable action=hooks::parser::top()
Ownership action=hooks::parser::top()
Yield action=hooks::parser::top()
Label action=hooks::parser::top()
Visibility action=hooks::parser::top()
If action=hooks::parser::top()
Else action=hooks::parser::top()
For action=hooks::parser::top()
In action=hooks::parser::top()
When action=hooks::parser::top()
Match action=hooks::parser::top()
Control action=hooks::parser::top()
Thread action=hooks::parser::top()
Error action=hooks::parser::top()
Drop action=hooks::parser::top()
Require action=hooks::parser::top()
Is action=hooks::parser::top()
Word action=hooks::parser::top()
Logical action=hooks::parser::top()
Comparison action=hooks::parser::top()
Comments action=hooks::parser::top()
Docs action=hooks::parser::top()
Annotation action=hooks::parser::top()
Unknown action=hooks::parser::top()
